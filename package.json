{
	"name": "hyprvox",
	"version": "0.17.0",
	"description": "Production-ready STT daemon for Linux with global hotkeys and clipboard history",
	"packageManager": "bun@1.3.3",
	"module": "index.ts",
	"type": "module",
	"files": [
		"index.ts",
		"src",
		"README.md",
		"package.json"
	],
	"bin": {
		"hyprvox": "index.ts"
	},
	"scripts": {
		"test": "NODE_ENV=test HYPRVOX_TEST_MODE=1 vitest run -c vitest.config.ts",
		"test:coverage": "NODE_ENV=test HYPRVOX_TEST_MODE=1 vitest run --coverage -c vitest.config.ts",
		"test:safe": "NODE_ENV=test HYPRVOX_TEST_MODE=1 vitest run -c vitest.config.ts",
		"test:integration": "NODE_ENV=test HYPRVOX_TEST_MODE=1 vitest run -c vitest.integration.config.ts",
		"test:integration:full": "NODE_ENV=test HYPRVOX_TEST_MODE=1 vitest run tests/integration/*.test.ts",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"build:overlay": "cd overlay && bun install && bun run build",
		"start:overlay": "cd overlay && bun run start"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@types/bun": "latest",
		"@types/node-notifier": "^8.0.5",
		"@types/pino": "^7.0.5",
		"@types/react": "^19.2.0",
		"@vitest/coverage-v8": "^4.0.17",
		"vitest": "^4.0.17"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@deepgram/sdk": "^4.11.3",
		"@opentui/core": "^0.2.12",
		"@opentui/react": "0.2.12",
		"clipboardy": "^5.0.2",
		"commander": "^14.0.2",
		"fastest-levenshtein": "^1.0.16",
		"groq-sdk": "^0.37.0",
		"node-global-key-listener": "^0.3.0",
		"node-notifier": "^10.0.1",
		"node-record-lpcm16": "^1.0.1",
		"pino": "^10.2.1",
		"pino-pretty": "^13.1.3",
		"react": "^19.2.6",
		"readline-sync": "^1.4.10",
		"rotating-file-stream": "^3.2.8",
		"scheduler": "^0.27.0",
		"yoctocolors": "^2.1.2",
		"zod": "^4.3.5"
	}
}
